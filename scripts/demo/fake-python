#!/usr/bin/env bash
# Stand-in for the Python that has ChromaDB, used only by scripts/demo.sh.
# The chunker and the alias report run for real under python3; the Chroma helper is
# pretended, so Index can be tried without ChromaDB or an embedding model.
case "$1" in
  *chroma_memory.py)
    sleep "${DEMO_DELAY:-2.5}"
    echo "Loading the embedding model (pretend)..."
    echo "Upserted 3 chunks into the demo store. Collection now holds 3."
    ;;
  *) exec python3 "$@" ;;
esac
